{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor|mcp__computer-use__.*|mcp__remote-devices__computer.*",
        "hooks": [
          { "type": "command", "timeout": 120, "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/scripts/unity-lock.ps1\" pre" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "timeout": 30, "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/scripts/unity-lock.ps1\" stop" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "timeout": 30, "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/scripts/unity-lock.ps1\" release" }
        ]
      }
    ]
  }
}
